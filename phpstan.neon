parameters:
    level: 8
    paths:
        - Api
        - Auth
        - Conditions
        - Controller
        - Config
        - DependencyInjection
        - EventListener
        - Form
        - Integration
        - MauticEasyBundle.php
        - Tests
    excludePaths:
        # runs inside an installed Mautic, whose container returns untyped services
        - Tests/Integration
