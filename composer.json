{
    "name": "easyemailverification/plugin-mautic",
    "description": "Easy Email Verification for Mautic: verify email addresses in campaign conditions and store the results in contact fields.",
    "type": "mautic-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "mautic",
        "plugin",
        "integration",
        "email verification",
        "email validation"
    ],
    "homepage": "https://www.easyemailverification.com",
    "support": {
        "issues": "https://github.com/EasyEmailVerification/plugin-mautic/issues",
        "email": "support@easyemailverification.com",
        "docs": "https://www.easyemailverification.com/mautic.md"
    },
    "authors": [
        {
            "name": "Easy Email Verification",
            "email": "support@easyemailverification.com",
            "homepage": "https://www.easyemailverification.com"
        }
    ],
    "extra": {
        "install-directory-name": "MauticEasyBundle"
    },
    "require": {
        "php": ">=8.0.2 <8.6",
        "ext-json": "*",
        "mautic/core-lib": "^5.0 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticEasyBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\MauticEasyBundle\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "composer/installers": false,
            "composer/package-versions-deprecated": true,
            "mautic/composer-plugin": false,
            "php-http/discovery": false,
            "symfony/flex": false,
            "symfony/runtime": false
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/mautic/FOSOAuthServerBundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/SpBundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/SymfonyBridgeBundle.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
